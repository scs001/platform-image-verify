+        monkeypatch.setenv("PREFLIGHT_CACHE_TTL", "30")
+
+        probe_client, patcher = _patch_probe_client(
+            response=_probe_response(200, {"data": []})
+        )
+        with patcher:
+            asyncio.run(pq.enforce_mcp_proxy_preflight(_claims(), "office-docs"))
